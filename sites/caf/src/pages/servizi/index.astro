---
import Base from '../../layouts/Base.astro';
import ListaServizi from '../../components/ListaServizi.astro';
import { azienda, telLink } from '@tutela/shared/azienda.ts';
---
<Base title="Servizi" description="Tutti i servizi CAF e Patronato di Tutela Previdenziale a Palazzolo sull'Oglio: 730, ISEE, IMU, successioni, colf e badanti, NASpI, pensioni.">
  <div class="wrap">
    <nav class="crumbs" aria-label="Percorso"><ol><li><a href="/">Home</a></li><li aria-current="page">Servizi</li></ol></nav>
  </div>
  <section class="section page-top">
    <div class="wrap">
      <div class="section-head">
        <h1>Servizi</h1>
        <p>Apri un servizio per vedere come funziona, quanto costa e la lista dei documenti da portare. Non trovi quello che cerchi? Chiamaci al <a href={telLink}>{azienda.telefono}</a>.</p>
      </div>
      <ListaServizi />
    </div>
  </section>
</Base>

<style>
  .page-top { padding-top: 1.5rem; }
</style>
