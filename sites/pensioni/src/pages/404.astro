---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata" description="La pagina che cerchi non esiste.">
  <div class="wrap nf">
    <h1>Questa pagina non esiste</h1>
    <p class="lead">Forse l'indirizzo è cambiato. Puoi ripartire dalla home o iniziare direttamente dal questionario.</p>
    <div class="nf-cta">
      <a class="btn btn-primary" href="/questionario/">Compila il questionario</a>
      <a class="btn btn-ghost" href="/">Torna alla home</a>
    </div>
  </div>
</Base>

<style>
  .nf { padding-block: clamp(4rem, 10vw, 8rem); display: grid; gap: 1.5rem; justify-items: start; }
  .nf-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
